<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">


	<!-- bean definitions here -->

	<bean id="employee1" class="com.bean.Employee">

		<constructor-arg name="id" value="11"></constructor-arg>
		<constructor-arg name="name" value="Rajesh"></constructor-arg>
		<constructor-arg name="salary" value="10000"></constructor-arg>

	</bean>


	<bean id="employee" class="com.bean.Employee">

		<property name="id" value="11"></property>
		<property name="name" value="Kalpesh"></property>
		<property name="salary" value="10000"></property>

	</bean>





</beans>